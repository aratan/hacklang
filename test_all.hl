// ============================================================
// test_all.hl -- Prueba integral de TODO lo que funciona
// ============================================================

// --- Let y Print ---
let x = 42;
print "x = ";
print x;

// --- Aritmetica ---
let suma = 10 + 20;
print "Suma: ";
print suma;

let resta = 100 - 30;
print "Resta: ";
print resta;

let mul = 6 * 7;
print "Multiplicacion: ";
print mul;

let div = 50 / 2;
print "Division: ";
print div;

// --- Precedencia ---
let combo = 2 + 3 * 4;
print "2 + 3 * 4 = ";
print combo;

let parens = (2 + 3) * 4;
print "(2 + 3) * 4 = ";
print parens;

// --- Strings ---
let saludo = "Hola desde HackLang!";
print saludo;

// --- String + Number ---
let str_num = "El valor es: ";
print str_num + 42;

let num_str = 100 + " puntos";
print num_str;

// --- Comparaciones ---
print "3 < 5 => ";
print 3 < 5;

print "5 < 3 => ";
print 5 < 3;

print "10 > 3 => ";
print 10 > 3;

print "3 > 10 => ";
print 3 > 10;

print "5 ~ 5 => ";
print 5 ~ 5;

print "3 ~ 5 => ";
print 3 ~ 5;

print "3 ^ 5 => ";
print 3 ^ 5;

print "5 ^ 5 => ";
print 5 ^ 5;

// --- Ternario ---
print "Ternario (1 < 2) ? 100 : 200 => ";
print (1 < 2) ? 100 : 200;

print "Ternario (1 > 2) ? 100 : 200 => ";
print (1 > 2) ? 100 : 200;

let max = (100 > 50) ? 100 : 50;
print "Max(100, 50) = ";
print max;

// --- If / Else ---
if (10 > 5) (
  print "10 > 5 es VERDADERO";
)

if (3 > 10) (
  print "Esto NO deberia verse";
) else (
  print "3 > 10 es FALSO -- else funciona!";
)

// --- While ---
let i = 0;
while (i < 3) (
  print "Iteracion: ";
  print i;
  i = i + 1;
)
print "While finalizado!";

// --- While sin iteraciones ---
let j = 10;
while (j < 5) (
  print "Esto NO se ejecuta";
  j = j + 1;
)
print "While con 0 iteraciones OK";

// --- Asignacion implicita (sin let) ---
let z = 0;
z = 100;
print "z despues de reasignar = ";
print z;

print "--- TODOS LOS TESTS PASARON ---";
